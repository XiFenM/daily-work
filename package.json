{
  "name": "daily-work-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "repo:doctor": "tsx tools/ops/src/doctor.ts",
    "skills:sync": "node scripts/materialize-skills.mjs",
    "skills:dry-run": "node scripts/materialize-skills.mjs --dry-run",
    "skills:check": "node scripts/materialize-skills.mjs --check",
    "zenmux": "node scripts/run-zenmux.mjs",
    "browser": "playwright-cli",
    "browser:install": "playwright-cli install-browser",
    "media:probe": "tsx tools/media/src/probe.ts",
    "pathnote:check": "node .pathnote/pathnote-source-check.mjs --source daily-work",
    "pathnote:check:staged": "node .pathnote/pathnote-source-check.mjs --source daily-work --staged",
    "video:studio": "pnpm --filter @daily-work/video studio",
    "video:render": "pnpm --filter @daily-work/video render",
    "video:still": "pnpm --filter @daily-work/video still",
    "video:smoke": "pnpm --filter @daily-work/video smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"tools/**/*.{ts,tsx}\" \"apps/**/*.{ts,tsx}\"",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run tools",
    "check": "pnpm skills:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "mime-types": "3.0.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.18",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
