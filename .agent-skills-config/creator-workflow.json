      "manifest_fact_ref": "package",
      "script": "zenmux",
      "subcommands": ["image"],
      "argument_bindings": [
        {
          "key": "count",
          "kind": "value",
          "value_type": "int",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "format",
          "kind": "value",
          "value_type": "string",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "model",
          "kind": "value",
          "value_type": "string",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "out",
          "kind": "output-base",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "prompt-file",
          "kind": "input-path",
          "authority": "user-provided",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "quality",
          "kind": "value",
          "value_type": "string",
          "required": true,
          "cardinality": "one"
        },
        {
          "key": "size",
          "kind": "value",
          "value_type": "string",
          "required": true,
          "cardinality": "one"
        }
      ],
      "output_bindings": [
        {
          "id": "images",
          "kind": "indexed-by-count",
          "source_argument": "out",
          "count_argument": "count",
          "condition": { "kind": "always" }
        },
        {
          "id": "response",
          "kind": "suffix",
          "source_argument": "out",
          "suffix": ".response.json",
          "condition": { "kind": "always" }
        }
      ],
      "billing_bindings": {
        "provider": { "kind": "literal", "value": "zenmux" },
        "model_or_tier": { "kind": "argument", "argument": "model" },
        "count": { "kind": "argument", "argument": "count" },
        "request_bounds": {
          "count": { "kind": "argument", "argument": "count" },
          "format": { "kind": "argument", "argument": "format" },
          "quality": { "kind": "argument", "argument": "quality" },
          "size": { "kind": "argument", "argument": "size" }
        }
      },
      "effects": {
        "billable": true,
        "remote": true,
        "destructive": false,
        "publish": false
      }
