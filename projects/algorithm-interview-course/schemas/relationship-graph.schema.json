{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/algorithm-interview-course/relationship-graph.schema.json",
  "title": "Algorithm Interview Course Relationship Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "allowedTypes", "edges"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "allowedTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "type",
        "strength",
        "status",
        "rationale",
        "confidence",
        "evidence",
        "createdBy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "type": {
          "enum": [
            "prerequisite_of",
            "recommended_before",
            "extends",
            "revisits",
            "applies",
            "contrasts_with",
            "alternative_to",
            "same_pattern_as",
            "same_problem_family_as",
            "uses_data_structure",
            "implements_algorithm",
            "solves_problem",
            "addresses_pitfall"
          ]
        },
        "strength": {
          "enum": ["weak", "medium", "strong"]
        },
        "status": {
          "enum": ["provisional", "verified", "rejected"]
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lessonId", "assetId", "startMs", "endMs", "locator"],
            "properties": {
              "lessonId": {
                "type": "string"
              },
              "assetId": {
                "type": ["string", "null"]
              },
              "startMs": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "endMs": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "locator": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "createdBy": {
          "type": "string"
        }
      }
    }
  }
}
