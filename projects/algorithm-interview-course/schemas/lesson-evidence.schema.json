{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/algorithm-interview-course/lesson-evidence.schema.json",
  "title": "Algorithm Interview Course Lesson Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lessonId",
    "chapterId",
    "titleObserved",
    "contentKind",
    "actualDurationSeconds",
    "timeline",
    "learningObjectives",
    "concepts",
    "problem",
    "solutionProgression",
    "codeArtifacts",
    "correctness",
    "complexity",
    "complexityAnalyses",
    "formulaArtifacts",
    "experiments",
    "examples",
    "edgeCases",
    "implementationPitfalls",
    "interviewPlaybook",
    "relationCandidates",
    "evidence",
    "uncertainties",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[0-9]{2}-[0-9]{2}$"
    },
    "chapterId": {
      "type": "string",
      "pattern": "^[0-9]{2}$"
    },
    "titleObserved": {
      "type": ["string", "null"]
    },
    "contentKind": {
      "enum": [
        "interview_strategy",
        "concept",
        "experiment",
        "problem_walkthrough",
        "anecdote",
        "conclusion",
        "mixed",
        "unknown"
      ]
    },
    "actualDurationSeconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineSegment"
      }
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedStatement"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      }
    },
    "problem": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/problem"
        }
      ]
    },
    "solutionProgression": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/solutionStage"
      }
    },
    "codeArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/codeArtifact"
      }
    },
    "correctness": {
      "$ref": "#/$defs/correctness"
    },
    "complexity": {
      "$ref": "#/$defs/complexity"
    },
    "complexityAnalyses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/complexityAnalysis"
      }
    },
    "formulaArtifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/formulaArtifact"
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedStatement"
      }
    },
    "edgeCases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedStatement"
      }
    },
    "implementationPitfalls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedStatement"
      }
    },
    "interviewPlaybook": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourcedStatement"
      }
    },
    "relationCandidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationCandidate"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-[0-9]{3,}$"
      },
      "uniqueItems": true
    },
    "sourcedStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "sourceClass", "evidenceIds"],
      "properties": {
        "statement": {
          "type": "string"
        },
        "sourceClass": {
          "enum": [
            "course_direct",
            "course_text",
            "editorial_inference",
            "supplemental"
          ]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "timelineSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startMs", "endMs", "topic", "summary", "evidenceIds"],
      "properties": {
        "startMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "endMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "topic": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalName",
        "namesObserved",
        "role",
        "definition",
        "evidenceIds"
      ],
      "properties": {
        "canonicalName": {
          "type": "string"
        },
        "namesObserved": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "introduces",
            "reinforces",
            "applies",
            "contrasts",
            "mentions"
          ]
        },
        "definition": {
          "type": ["string", "null"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "problemId",
        "titleObserved",
        "statement",
        "constraints",
        "clarifyingQuestions",
        "evidenceIds"
      ],
      "properties": {
        "platform": {
          "type": ["string", "null"]
        },
        "problemId": {
          "type": ["string", "null"]
        },
        "titleObserved": {
          "type": ["string", "null"]
        },
        "statement": {
          "type": ["string", "null"]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "clarifyingQuestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "solutionStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "idea",
        "timeComplexity",
        "spaceComplexity",
        "limitations",
        "evidenceIds"
      ],
      "properties": {
        "stage": {
          "enum": [
            "baseline",
            "observation",
            "intermediate",
            "optimized",
            "alternative"
          ]
        },
        "idea": {
          "type": "string"
        },
        "timeComplexity": {
          "type": ["string", "null"]
        },
        "spaceComplexity": {
          "type": ["string", "null"]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "codeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "sourceKind",
        "code",
        "ocrUncertainties",
        "verification",
        "evidenceIds"
      ],
      "properties": {
        "language": {
          "type": ["string", "null"]
        },
        "sourceKind": {
          "enum": ["shown_in_video", "reconstructed", "supplemental"]
        },
        "code": {
          "type": "string"
        },
        "ocrUncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verification": {
          "enum": ["not_run", "compiled", "tested", "failed"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "claims"],
      "properties": {
        "method": {
          "enum": [
            "not_applicable",
            "loop_invariant",
            "recursive_contract",
            "induction",
            "state_transition",
            "exchange_argument",
            "experimental_validation",
            "other",
            "unknown"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcedStatement"
          }
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "space", "assumptions", "evidenceIds"],
      "properties": {
        "time": {
          "type": ["string", "null"]
        },
        "space": {
          "type": ["string", "null"]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "complexityVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "meaning", "domainOrRelationship", "evidenceIds"],
      "properties": {
        "symbol": {
          "type": "string"
        },
        "meaning": {
          "type": ["string", "null"]
        },
        "domainOrRelationship": {
          "type": ["string", "null"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "complexityAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "measure",
        "notation",
        "case",
        "expressionObserved",
        "expressionNormalized",
        "normalizationSourceClass",
        "variables",
        "costModel",
        "derivationSteps",
        "assumptions",
        "conclusion",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^cx-[0-9]{3,}$"
        },
        "subject": {
          "type": "string"
        },
        "measure": {
          "enum": ["time", "auxiliary_space", "stack_space", "operation_count"]
        },
        "notation": {
          "enum": ["O", "Theta", "Omega", "none", "unknown"]
        },
        "case": {
          "enum": [
            "worst",
            "average",
            "best",
            "amortized",
            "expected",
            "empirical",
            "unspecified"
          ]
        },
        "expressionObserved": {
          "type": ["string", "null"]
        },
        "expressionNormalized": {
          "type": ["string", "null"]
        },
        "normalizationSourceClass": {
          "enum": [
            "course_direct",
            "course_text",
            "editorial_inference",
            "supplemental"
          ]
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/complexityVariable"
          }
        },
        "costModel": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourcedStatement"
            }
          ]
        },
        "derivationSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcedStatement"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcedStatement"
          }
        },
        "conclusion": {
          "$ref": "#/$defs/sourcedStatement"
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "formulaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "sourceKind",
        "rawText",
        "normalizedText",
        "variables",
        "completeness",
        "ocrUncertainties",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^formula-[0-9]{3,}$"
        },
        "kind": {
          "enum": ["formula", "recurrence", "summation", "inequality", "table"]
        },
        "sourceKind": {
          "enum": ["shown_in_video", "reconstructed"]
        },
        "rawText": {
          "type": ["string", "null"]
        },
        "normalizedText": {
          "type": ["string", "null"]
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/complexityVariable"
          }
        },
        "completeness": {
          "enum": ["complete", "partial", "uncertain"]
        },
        "ocrUncertainties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "experimentMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputDescription",
        "inputSize",
        "observedValue",
        "unit",
        "evidenceIds"
      ],
      "properties": {
        "inputDescription": {
          "type": ["string", "null"]
        },
        "inputSize": {
          "type": ["string", "null"]
        },
        "observedValue": {
          "type": ["string", "number", "null"]
        },
        "unit": {
          "type": ["string", "null"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "purpose",
        "setup",
        "measurements",
        "theoreticalExpectation",
        "observation",
        "limitations",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^experiment-[0-9]{3,}$"
        },
        "subject": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/sourcedStatement"
        },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "language",
            "compilerOrRuntime",
            "optimization",
            "operatingSystem",
            "hardware",
            "timer",
            "warmup",
            "repetitions",
            "inputGeneration"
          ],
          "properties": {
            "language": {
              "type": ["string", "null"]
            },
            "compilerOrRuntime": {
              "type": ["string", "null"]
            },
            "optimization": {
              "type": ["string", "null"]
            },
            "operatingSystem": {
              "type": ["string", "null"]
            },
            "hardware": {
              "type": ["string", "null"]
            },
            "timer": {
              "type": ["string", "null"]
            },
            "warmup": {
              "type": ["string", "null"]
            },
            "repetitions": {
              "type": ["string", "null"]
            },
            "inputGeneration": {
              "type": ["string", "null"]
            }
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/experimentMeasurement"
          }
        },
        "theoreticalExpectation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourcedStatement"
            }
          ]
        },
        "observation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourcedStatement"
            }
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcedStatement"
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "relationCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "type",
        "status",
        "rationale",
        "confidence",
        "basis",
        "evidenceIds"
      ],
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^lesson:[0-9]{2}-[0-9]{2}$"
        },
        "to": {
          "type": "string",
          "pattern": "^lesson:[0-9]{2}-[0-9]{2}$"
        },
        "type": {
          "enum": [
            "prerequisite_of",
            "recommended_before",
            "extends",
            "revisits",
            "applies",
            "contrasts_with",
            "alternative_to",
            "same_pattern_as",
            "same_problem_family_as"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "status": {
          "const": "provisional"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "enum": ["explicit_in_lesson", "editorial_hypothesis"]
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceType",
        "startMs",
        "endMs",
        "assetId",
        "locator",
        "observation",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ev-[0-9]{3,}$"
        },
        "sourceType": {
          "enum": [
            "video_audio",
            "video_visual",
            "video_combined",
            "text",
            "editorial_inference"
          ]
        },
        "startMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "endMs": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "assetId": {
          "type": ["string", "null"]
        },
        "locator": {
          "type": ["string", "null"]
        },
        "observation": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason", "recommendedCheck"],
      "properties": {
        "field": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "recommendedCheck": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "requestId", "promptVersion", "generatedAt"],
      "properties": {
        "model": {
          "type": ["string", "null"]
        },
        "requestId": {
          "type": ["string", "null"]
        },
        "promptVersion": {
          "type": "string"
        },
        "generatedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    }
  }
}
