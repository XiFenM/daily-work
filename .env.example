# ZenMux credentials. Never commit real values.
ZENMUX_API_KEY=
ZENMUX_MANAGEMENT_KEY=

# API endpoints. Keep these unless ZenMux publishes a migration.
ZENMUX_BASE_URL=https://zenmux.ai/api/v1
ZENMUX_VIDEO_BASE_URL=https://zenmux.ai/api/v1

# Defaults verified against ZenMux docs on 2026-07-26.
# Run `pnpm zenmux models` and override these when the catalog changes.
ZENMUX_CHAT_MODEL=
ZENMUX_IMAGE_MODEL=openai/gpt-image-2
ZENMUX_VIDEO_MODEL=bytedance/doubao-seedance-2.0
ZENMUX_UNDERSTAND_MODEL=google/gemini-2.5-pro

# Native video jobs are asynchronous. ZenMux recommends polling every 15 seconds.
ZENMUX_POLL_INTERVAL_MS=15000
ZENMUX_VIDEO_TIMEOUT_MS=900000
