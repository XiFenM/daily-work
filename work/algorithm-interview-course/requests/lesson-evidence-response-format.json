            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "sourceClass",
                "evidenceIds"
              ],
              "properties": {
                "statement": {
                  "type": "string"
                },
                "sourceClass": {
                  "enum": [
                    "course_direct",
                    "course_text",
                    "editorial_inference",
                    "supplemental"
                  ],
                  "type": "string"
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^ev-[0-9]{3,}$"
                  }
                }
              }
            }
          },
          "relationCandidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "from",
                "to",
                "type",
                "status",
                "rationale",
                "confidence",
                "basis",
                "evidenceIds"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "pattern": "^lesson:[0-9]{2}-[0-9]{2}$"
                },
                "to": {
                  "type": "string",
                  "pattern": "^lesson:[0-9]{2}-[0-9]{2}$"
                },
                "type": {
                  "enum": [
                    "prerequisite_of",
                    "recommended_before",
                    "extends",
                    "revisits",
                    "applies",
                    "contrasts_with",
                    "alternative_to",
                    "same_pattern_as",
                    "same_problem_family_as"
                  ],
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "provisional"
                  ],
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "basis": {
                  "enum": [
                    "explicit_in_lesson",
                    "editorial_hypothesis"
                  ],
                  "type": "string"
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^ev-[0-9]{3,}$"
                  }
                }
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sourceType",
                "startMs",
                "endMs",
                "assetId",
                "locator",
                "observation",
                "confidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^ev-[0-9]{3,}$"
                },
                "sourceType": {
                  "enum": [
                    "video_audio",
                    "video_visual",
                    "video_combined",
                    "text",
                    "editorial_inference"
                  ],
                  "type": "string"
                },
                "startMs": {
                  "type": "integer",
                  "nullable": true,
                  "minimum": 0
                },
                "endMs": {
                  "type": "integer",
                  "nullable": true,
                  "minimum": 0
                },
                "assetId": {
                  "type": "string",
                  "nullable": true
                },
                "locator": {
                  "type": "string",
                  "nullable": true
                },
                "observation": {
                  "type": "string"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "reason",
                "recommendedCheck"
              ],
              "properties": {
                "field": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "recommendedCheck": {
                  "type": "string"
                }
              }
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "requestId",
              "promptVersion",
              "generatedAt"
            ],
            "properties": {
              "model": {
                "type": "string",
                "nullable": true
              },
              "requestId": {
                "type": "string",
                "nullable": true
              },
              "promptVersion": {
                "type": "string"
              },
              "generatedAt": {
                "type": "string",
                "nullable": true,
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  }
}
