  "problem": {
    "platform": "LeetCode",
    "problemId": "455",
    "titleObserved": "Assign Cookies",
    "statement": "假设你想给小朋友们发饼干，每个小朋友最多只能拿到一块饼干。每个小朋友都有一个贪心指数 g(i)，即需要饼干大小的最小值。同时每块饼干都有一个大小值 s(j)。如果 s(j) >= g(i)，将饼干 j 分给小朋友 i，小朋友就会很开心。给定数组 s 和 g，问如何分配饼干才能让最多的小朋友开心。",
    "constraints": [
      "每个小朋友最多只能分到一块饼干",
      "只有当 s(j) >= g(i) 时小朋友才会开心"
    ],
    "clarifyingQuestions": [],
    "evidenceIds": [
      "ev-002"
    ]
  },
  "solutionProgression": [
    {
      "id": "solution-001",
      "stage": "optimized",
      "idea": "将饼干数组 s 和小朋友贪心指数数组 g 分别按从大到小排序。优先尝试用当前剩余最大的饼干满足当前剩余最贪心（需求最大）的小朋友。若能满足，则将该饼干分给该小朋友，双指针均向后移动；若不能满足，说明没有任何剩余饼干能满足该小朋友，放弃该小朋友，将小朋友指针移动到下一个需求较小的小朋友继续尝试。",
      "timeComplexity": "O(n log n)",
      "spaceComplexity": "O(1)",
      "limitations": [],
