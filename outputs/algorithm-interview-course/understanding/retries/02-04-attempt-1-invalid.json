  "codeArtifacts": [
    {
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "code": "namespace MyAlgorithmTester {\n    // O(logN)\n    int binarySearch(int arr[], int n, int target) {\n        int l = 0, r = n - 1;\n        while (l <= r) {\n            int mid = l + (r - l) / 2;\n            if (arr[mid] == target) return mid;\n            if (arr[mid] > target) r = mid - 1;\n            else l = mid + 1;\n        }\n        return -1;\n    }\n\n    // O(N)\n    int findMax(int arr[], int n) {\n        assert(n > 0);\n        int res = arr[0];\n        for (int i = 1; i < n; i++)\n            if (arr[i] > res)\n                res = arr[i];\n        return res;\n    }\n}",
      "ocrUncertainties": [],
      "verification": "not_run",
      "evidenceIds": [
        "ev-006",
        "ev-020"
      ]
    },
    {
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "code": "namespace MyUtil {\n    int *generateRandomArray(int n, int rangeL, int rangeR) {\n        assert(n > 0 && rangeL <= rangeR);\n        int *arr = new int[n];\n        srand(time(NULL));\n        for (int i = 0; i < n; i++)\n            arr[i] = rand() % (rangeR - rangeL + 1) + rangeL;\n        return arr;\n    }\n\n    int *generateOrderedArray(int n) {\n        assert(n > 0);\n        int *arr = new int[n];\n        for (int i = 0; i < n; i++)\n            arr[i] = i;\n        return arr;\n    }\n}",
      "ocrUncertainties": [],
      "verification": "not_run",
      "evidenceIds": [
        "ev-007"
      ]
    },
    {
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "code": "int main() {\n    // 数据规模倍增测试 findMax\n    // O(N)\n    for (int i = 10; i <= 26; i++) {\n        int n = pow(2, i);\n        int *arr = MyUtil::generateRandomArray(n, 0, 100000000);\n\n        clock_t startTime = clock();\n        MyAlgorithmTester::findMax(arr, n);\n        clock_t endTime = clock();\n\n        cout << \"data size 2^\" << i << \" = \" << n << \"\\t\";\n        cout << \"Time cost: \" << double(endTime - startTime) / CLOCKS_PER_SEC << \"s\" << endl;\n\n        delete[] arr;\n    }\n    return 0;\n}",
