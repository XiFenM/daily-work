    {
      "id": "code-003",
      "solutionStageId": "solution-003",
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Solution {\npublic:\n    // 时间复杂度 O(n)\n    // 空间复杂度 O(1)\n    void moveZeroes(vector<int>& nums) {\n        int k = 0; // nums中, [0...k)的元素均为非0元素\n        \n        // 遍历到第i个元素后, 保证[0...i]中所有非0元素\n        // 都按照顺序排列在[0...k)中\n        // 同时, [k...i] 为0\n        for(int i = 0 ; i < nums.size() ; i ++)\n            if(nums[i]){\n                if( i != k )\n                    swap( nums[k++] , nums[i] );\n                else // i == k\n                    k ++;\n            }\n    }\n};",
