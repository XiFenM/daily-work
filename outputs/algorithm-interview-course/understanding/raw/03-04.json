  "solutionProgression": [
    {
      "id": "solution-001",
      "stage": "intermediate",
      "idea": "设置索引 k，遍历数组将所有非零元素按顺序覆写到 [0...k) 中；遍历结束后，将 [k...nums.size()) 的所有剩余位置赋值为 0。",
      "timeComplexity": "O(n)",
      "spaceComplexity": "O(1)",
      "limitations": [
        "需要两趟遍历/赋值操作，第二趟需要显式将剩余位置置 0"
      ],
