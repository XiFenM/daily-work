    ]
  },
  "solutionProgression": [
    {
      "id": "solution-001",
      "stage": "intermediate",
      "idea": "维护大小不超过 k 的滑动窗口查找表 record（使用 std::set<int>），针对当前元素 nums[i]，利用 lower_bound 查找 >= nums[i] - t 的最小元素，检查其是否 <= nums[i] + t。",
      "timeComplexity": "O(N log N)",
      "spaceComplexity": "O(K)",
