    },
    {
      "id": "code-002",
      "solutionStageId": "solution-002",
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Knapsack01{\npublic:\n    int knapsack01(const vector<int>& w, const vector<int>& v, int C){\n        assert(w.size() == v.size() && C >= 0);\n        int n = w.size();\n        if( n == 0 || C == 0 )\n            return 0;\n\n        vector<int> memo(C+1, -1);\n\n        for(int j = 0 ; j <= C ; j++ )\n            memo[j] = ( j >= w[0] ? v[0] : 0 );\n\n        for(int i = 1 ; i < n ; i ++ )\n            for(int j = C ; j >= w[i] ; j -- ){\n                memo[j] = max( memo[j] , v[i] + memo[j-w[i]] );\n            }\n\n        return memo[C];\n    }\n};",
