  "codeArtifacts": [
    {
      "id": "code-001",
      "solutionStageId": "solution-003",
      "language": "C++",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "#include <iostream>\n#include <vector>\n#include <cassert>\n\nusing namespace std;\n\nclass Solution {\npublic:\n    int minSubArrayLen(int s, vector<int>& nums) {\n\n        int l = 0, r = -1; // nums[l...r]为我们的滑动窗口\n        int sum = 0;\n        int res = nums.size() + 1;\n\n        while( l < nums.size() ){\n\n            if( r + 1 < nums.size() && sum < s )\n                sum += nums[++r];\n            else\n                sum -= nums[l++];\n\n            if( sum >= s )\n                res = min( res, r - l + 1 );\n        }\n\n        if( res == nums.size() + 1 )\n            return 0;\n\n        return res;\n    }\n};",
      "ocrUncertainties": [],
      "verification": "not_run",
      "evidenceIds": [
