      "language": "cpp",
      "sourceKind": "shown_in_video",
      "code": "#include <iostream>\n#include <cmath>\n#include <ctime>\n\nusing namespace std;\n\nint main() {\n    for( int x = 1 ; x <= 9 ; x ++ ){\n        int n = pow(10, x);\n        clock_t startTime = clock();\n        int sum = 0;\n        for( int i = 0 ; i < n ; i ++ )\n            sum += i;\n        clock_t endTime = clock();\n        cout<<\"10^\"<<x<<\" : \"<<double(endTime - startTime)/CLOCKS_PER_SEC<<\" s\"<<endl;\n    }\n    return 0;\n}",
