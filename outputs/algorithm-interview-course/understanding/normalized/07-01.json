      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Solution {\npublic:\n    int maxDepth(TreeNode* root) {\n        if( root == NULL )\n            return 0;\n\n        int leftMaxDepth = maxDepth(root->left);\n        int rightMaxDepth = maxDepth(root->right);\n        return max(leftMaxDepth, rightMaxDepth) + 1;\n    }\n};",
