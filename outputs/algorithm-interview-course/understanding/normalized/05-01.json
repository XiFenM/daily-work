      "id": "code-001",
      "solutionStageId": "solution-002",
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Solution {\npublic:\n    ListNode* reverseList(ListNode* head) {\n        ListNode* pre = NULL;\n        ListNode* cur = head;\n        while( cur != NULL ){\n            ListNode* next = cur->next;\n            \n            cur->next = pre;\n            pre = cur;\n            cur = next;\n        }\n        \n        return pre;\n    }\n};",
