      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "#include <iostream>\n#include <vector>\n\nusing namespace std;\n\nclass Solution {\npublic:\n    int climbStairs(int n) {\n        vector<int> memo(n + 1, -1);\n        memo[0] = 1;\n        memo[1] = 1;\n        for (int i = 2; i <= n; i++)\n            memo[i] = memo[i - 1] + memo[i - 2];\n        return memo[n];\n    }\n};",
