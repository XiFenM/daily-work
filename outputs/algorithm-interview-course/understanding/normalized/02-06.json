  "codeArtifacts": [
    {
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "code": "template <typename T>\nclass MyVector {\nprivate:\n    T* data;\n    int capacity; // 存储数组中可以容纳的最大元素个数\n    int size;     // 存储数组中的元素个数\n\n    void resize(int newCapacity) {\n        assert(newCapacity >= size);\n        T* newData = new T[newCapacity];\n        for (int i = 0; i < size; i++) {\n            newData[i] = data[i];\n        }\n        delete[] data;\n        data = newData;\n        capacity = newCapacity;\n    }\n\npublic:\n    MyVector() {\n        data = new T[10];\n        capacity = 10;\n        size = 0;\n    }\n\n    ~MyVector() {\n        delete[] data;\n    }\n\n    // Average: O(1)\n    void push_back(T e) {\n        if (size == capacity) {\n            resize(2 * capacity);\n        }\n        data[size++] = e;\n    }\n\n    T pop_back() {\n        assert(size > 0);\n        size--;\n        return data[size];\n    }\n};",
