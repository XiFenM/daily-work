  "codeArtifacts": [
    {
      "id": "code-001",
      "solutionStageId": "solution-002",
      "language": "C++",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Solution {\npublic:\n    void sortColors(vector<int>& nums) {\n        int count[3] = {0}; // 存放0, 1, 2三个元素的频率\n        for (int i = 0; i < nums.size(); i++) {\n            assert(nums[i] >= 0 && nums[i] <= 2);\n            count[nums[i]]++;\n        }\n\n        int index = 0;\n        for (int i = 0; i < count[0]; i++)\n            nums[index++] = 0;\n        for (int i = 0; i < count[1]; i++)\n            nums[index++] = 1;\n        for (int i = 0; i < count[2]; i++)\n            nums[index++] = 2;\n    }\n};",
      "ocrUncertainties": [],
      "verification": "not_run",
      "evidenceIds": [
        "ev-003"
      ]
    },
    {
      "id": "code-002",
      "solutionStageId": "solution-003",
      "language": "C++",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "class Solution {\npublic:\n    void sortColors(vector<int>& nums) {\n        int zero = -1; // nums[0...zero] == 0\n        int two = nums.size(); // nums[two...n-1] == 2\n        for (int i = 0; i < two; ) {\n            if (nums[i] == 1) {\n                i++;\n            } else if (nums[i] == 2) {\n                two--;\n                swap(nums[i], nums[two]);\n            } else {\n                assert(nums[i] == 0);\n                zero++;\n                swap(nums[zero], nums[i]);\n                i++;\n            }\n        }\n    }\n};",
      "ocrUncertainties": [],
