  "codeArtifacts": [
    {
      "id": "code-001",
      "solutionStageId": "solution-001",
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "template<typename T>\nint binarySearch(T arr[], int n, T target) {\n    int l = 0, r = n; // 在 [l...r) 的范围里寻找 target\n    while (l < r) {   // 当 l == r 时，区间 [l...r) 依然是无效的\n        int mid = (l + r) / 2;\n        if (arr[mid] == target)\n            return mid;\n        if (target > arr[mid])\n            l = mid + 1; // target 在 [mid+1...r) 中\n        else             // target < arr[mid]\n            r = mid;     // target 在 [l...mid) 中\n    }\n    return -1;\n}",
      "ocrUncertainties": [],
      "verification": "not_run",
      "evidenceIds": [
