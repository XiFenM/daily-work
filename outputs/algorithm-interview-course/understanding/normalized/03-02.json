      "completeness": "complete",
      "code": "template<typename T>\nint binarySearch(T arr[], int n, T target) {\n    int l = 0, r = n;\n    while (l < r) {\n        int mid = l + (r - l) / 2;\n        if (arr[mid] == target)\n            return mid;\n        if (target > arr[mid])\n            l = mid + 1;\n        else\n            r = mid;\n    }\n    return -1;\n}",
