    {
      "id": "solution-001",
      "stage": "baseline",
      "idea": "使用闭区间 [l...r] 维护搜索范围，初始 l = 0，r = n - 1；只要 l <= r，即搜索区间有效，就计算 mid = (l + r) / 2 并与 target 比较，进而将区间缩小为 [mid + 1...r] 或 [l...mid - 1]。",
      "timeComplexity": "O(log n)",
      "spaceComplexity": "O(1)",
      "limitations": [],
