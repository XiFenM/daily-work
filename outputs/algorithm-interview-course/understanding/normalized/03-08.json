      "id": "code-001",
      "solutionStageId": "solution-001",
      "language": "cpp",
      "sourceKind": "shown_in_video",
      "completeness": "complete",
      "code": "#include <iostream>\n#include <string>\n#include <cassert>\n#include <algorithm>\n\nusing namespace std;\n\nclass Solution {\npublic:\n    int lengthOfLongestSubstring(string s) {\n        int freq[256] = {0};\n        int l = 0, r = -1; // 滑动窗口为s[l...r]\n        int res = 0;\n\n        while( l < s.size() ){\n            if( r + 1 < s.size() && freq[s[r+1]] == 0 )\n                freq[s[++r]] ++;\n            else // r + 1 >= s.size() || freq[s[r+1]] == 1\n                freq[s[l++]] --;\n\n            res = max( res, r - l + 1 );\n        }\n\n        return res;\n    }\n};",
